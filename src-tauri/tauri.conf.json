{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SanctuaryFlow",
  "version": "0.1.1",
  "identifier": "org.sanctuaryflow.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SanctuaryFlow",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "visible": false,
        "backgroundColor": "#f4f5f7",
        "create": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "font-src": "'self' data:",
        "frame-src": "https://www.canva.com",
        "connect-src": "'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "SanctuaryFlow",
    "copyright": "Copyright © 2026 SanctuaryFlow contributors",
    "category": "Productivity",
    "shortDescription": "Offline-first worship presentation",
    "longDescription": "SanctuaryFlow presents song lyrics, Scripture, announcements and media on a projector during worship services, and keeps working without an internet connection.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
